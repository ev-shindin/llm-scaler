# TWO MODELS, ANTI-PHASE BURSTS, WARM POOL ON AND OFF -- the specification.
#
# `--spec` resolves a SPECIFICATION (config/specification/<name>.yaml.j2), never
# a scenario, and a scenario without one is invisible to the CLI: it reports
# "Specification 'guides/two-model-warm-pool' not found" and prints the list it
# does know, which is a confusing thing to read when the scenario file is
# plainly sitting in the clone. This file is the half that makes ours findable;
# `benchmark-standup` copies it into config/specification/ beside the scenario.
#
# It carries no settings of its own. Everything that decides the run is in
# two-model-warm-pool.yaml next to it -- the two stacks, their accelerators and
# the WVA/KEDA bounds -- and the load, the pool and the comparison are in
# hack/benchmark/two_model_pool.sh.
#
# Base: upstream config/specification/examples/multi-model-optimized-baseline.yaml.j2,
# with scenario_file pointed at ours.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/guides/two-model-warm-pool.yaml
