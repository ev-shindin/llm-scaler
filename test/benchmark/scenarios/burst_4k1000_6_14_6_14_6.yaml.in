# Ofer's profile from biran-20260822-021153-340, reconstructed from the rendered
# workload that run captured. Five 12-minute stages alternating 6 and 14 QPS,
# with a FIXED 4000-token input and 1000-token output (std_dev 0) rather than a
# distribution -- the constant shape is what makes each replica's KV footprint
# predictable, and therefore what makes the demand signal comparable run to run.
load:
  type: constant
  stages:
  - rate: 6
    duration: 720
  - rate: 14
    duration: 720
  - rate: 6
    duration: 720
  - rate: 14
    duration: 720
  - rate: 6
    duration: 720
  request_timeout: 300
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
data:
  type: random
  input_distribution:
    min: 4000
    max: 4000
    mean: 4000
    std_dev: 0
    total_count: 33120
  output_distribution:
    min: 1000
    max: 1000
    mean: 1000
    std_dev: 0
    total_count: 33120
report:
  request_lifecycle:
    summary: true
    per_stage: true
    per_request: false
