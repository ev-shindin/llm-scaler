# The three engine configurations the P/D role-switch evaluation compares.
#
#   source test/evaluation/pd-role-switch/arms.env
#   arm_flags A prefill     # -> the vllm serve flags for that arm and role
#   arm_env   A prefill     # -> the environment for it
#
# What each arm isolates, and why B vs C is the one nobody has measured, is in
# docs/proposals/pd-role-switch-evaluation.md. Role-defining values here are
# copied from the deployed LeaderWorkerSets in glm_data/; capacity values are
# NOT, because production is EP32 on H100-80GB and this is EP16 on H200-141GB.
#
# ARM C NEEDS AN ENGINE THIS REPOSITORY DOES NOT CONTAIN. The role-switch patch
# lives in the vLLM fork:
#
#   repo    github.com/ev-shindin/vllm-conf
#   branch  feat/pd-role-switch
#   apply   tools/pd_role_switch/README.md, section 1b -- into the stock image
#           vllm/vllm-openai:nightly-385dce36bcee42309924a5ece951a96db3dce7f2
#   verify  13 hunks, 0 rejects; then `import vllm.v1.engine.pd_role` succeeds
#
# Arms A and B run that same image unmodified. All three also need deep_ep
# rebuilt against the NCCL in the image (build_deep_ep.sh in the same repo), and
# an rdma/ib device -- deepep_v2 refuses to start without one, single node
# included.

MODEL="${MODEL:-zai-org/GLM-5.3}"      # production serves 5.3; the harness
                                       # defaults to 5.2, so set it explicitly
EP="${EP:-16}"
GPUS_PER_NODE="${GPUS_PER_NODE:-8}"

# Role definition -- copied from production, same for every arm.
PREFILL_BATCHED_TOKENS=1024
PREFILL_MAX_SEQS=32
PREFILL_GPU_UTIL=0.90
DECODE_BATCHED_TOKENS=128
DECODE_MAX_SEQS=128
DECODE_GPU_UTIL=0.95
SPEC_CONFIG='{"method":"mtp","num_speculative_tokens":3}'

arm_backend () {   # $1=arm $2=role
  case "$1:$2" in
    A:prefill) echo deepep_high_throughput ;;
    A:decode)  echo deepep_low_latency ;;
    B:*|C:*)   echo deepep_v2 ;;
    *) echo "unknown arm/role: $1/$2" >&2; return 1 ;;
  esac
}

arm_flags () {     # $1=arm $2=role
  local backend role_flags
  backend=$(arm_backend "$1" "$2") || return 1

  if [ "$2" = prefill ]; then
    role_flags="--max-num-batched-tokens $PREFILL_BATCHED_TOKENS \
                --max-num-seqs $PREFILL_MAX_SEQS \
                --gpu-memory-utilization $PREFILL_GPU_UTIL"
  else
    # FULL_DECODE_ONLY matches production's decode group.
    role_flags="--max-num-batched-tokens $DECODE_BATCHED_TOKENS \
                --max-num-seqs $DECODE_MAX_SEQS \
                --gpu-memory-utilization $DECODE_GPU_UTIL \
                --compilation-config {\"cudagraph_mode\":\"FULL_DECODE_ONLY\"}"
  fi

  # deep_gemm derives the expert count from the tensor it is given, and
  # deepep_v2 pads that layout, so only arm A can use it. That is a real thing
  # B and C give up against production -- part of what A-vs-B measures.
  local moe=""
  [ "$1" = A ] && moe="--moe-backend deep_gemm"

  echo "--trust-remote-code --block-size 64 --kv-cache-dtype fp8 \
        --enable-expert-parallel --tensor-parallel-size 1 \
        --data-parallel-size $EP --data-parallel-size-local $GPUS_PER_NODE \
        --all2all-backend $backend $moe \
        --speculative-config $SPEC_CONFIG $role_flags"
}

arm_env () {       # $1=arm
  # Common to every arm: two nodes, IB fabric, and a startup timeout long
  # enough for the weight load. 600s is the default and is not enough -- the
  # API servers abandon startup and the pod sits Running, which reads as a hang.
  local common="VLLM_DEEPEP_V2_ALLOW_HYBRID_MODE=0 NVSHMEM_HCA_PREFIX=ibp \
                VLLM_ENGINE_READY_TIMEOUT_S=3600 HF_HOME=/mnt/local/hf-cache"
  case "$1" in
    A) echo "$common VLLM_USE_DEEP_GEMM=1" ;;
    B) echo "$common VLLM_USE_DEEP_GEMM=0" ;;
    # C is B plus the switch: dev mode exposes /switch_pd_role, and keeping the
    # outgoing buffer is what makes a switch back a reuse rather than a rebuild.
    C) echo "$common VLLM_USE_DEEP_GEMM=0 VLLM_SERVER_DEV_MODE=1 VLLM_PD_KEEP_PREVIOUS=1" ;;
    *) echo "unknown arm: $1" >&2; return 1 ;;
  esac
}
