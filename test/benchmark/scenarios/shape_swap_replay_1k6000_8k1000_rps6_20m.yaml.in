metadata:
  labels:
    name: shape-swap-1k6000-8k1000-rps6
    description: |
      Two-stage shape swap replayed from a pre-generated trace
      (hack/benchmark/gen_shape_trace.py): 1000/6000 tokens for 1100s, then
      8000/1000 tokens for 1100s, both RPS=6 via Poisson arrivals, fixed
      lengths. Rate never changes -- isolates shape as the variable driving
      any change in WVA's behavior. The mirror of the 8000/1000 ->
      1000/6000 swap: same seed and durations, phases exchanged, so the
      pair isolates the direction of the swap.
spec:
  backend:
    kind: openai_http
    target: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
    model: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
    request_format: /v1/completions
  profile:
    kind: replay
    time_scale: 1.0
  # See shape_swap_replay.yaml.in for the full rationale on why this must be
  # a local file bundled via the guidellm-profiles ConfigMap (no URL support
  # in guidellm's trace_synthetic loader) at the harness-name-parameterized
  # mount path /workspace/profiles/guidellm/. This trace is 926KB against
  # the ConfigMap's 1MiB ceiling -- the tightest of the shape-swap set,
  # because the decode-heavy phase is the one with the higher arrival count;
  # its timestamps are rounded to the millisecond for that reason.
  data:
    - kind: trace_synthetic
      path: /workspace/profiles/guidellm/shape_1k6000_8k1000_rps6_20m.jsonl
  constraints:
    - kind: max_duration
      seconds: 2400
